# OSCA project configuration (hand-maintained). Generated from the copier template;
# run `uvx copier update` to pick up template changes.
schema: osca/v1
project: {{ project_id }}
name: {{ project_name }}
osca_version: ">=0.5,<0.6"

upstream:
  remote: upstream
  repository: {{ upstream_url }}
  branch: {{ upstream_branch }}
  track: {{ track }}
{%- if track == 'tags' %}
  tag_pattern: '{{ tag_pattern }}'
{%- endif %}
  mirror_branch: mirror/{{ upstream_branch }}

study:
  branch: study/zh-CN
  language: zh-CN
  strategy: inline-comments
  marker: "【zh】"
  # Build-generated tracked files (e.g. cbindgen output rendered from doc comments).
  # They must stay byte-identical to upstream.
  generated: []

license: {{ license }}

scope:
  # Which symbols count towards coverage (impl blocks are indexed but not counted).
  symbols:
    min_body_lines: 5
    exclude_kinds: [impl]
  include:
{%- for p in scope_include %}
    - "{{ p }}"
{%- endfor %}
  exclude:
{%- for p in scope_exclude %}
    - "{{ p }}"
{%- endfor %}

terminology: [{{ terminology | join(', ') }}]

atlas:
  repo: {{ atlas_repo }}
  ref: {{ osca_ref }}

# `osca translate` (structured annotation patches, ADR 0005)
ai:
  backend: claude-code      # claude-code = Claude subscription via `claude -p`; api = ANTHROPIC_API_KEY
  model: claude-sonnet-5-5
  effort: medium            # low | medium | high | xhigh | max
  max_symbols_per_request: 20
  fallbacks: true           # server-side refusal fallback (not used for batches)

build:
  check: "{{ build_check }}"
  # Doc builds catch annotation problems that `check` cannot (e.g. rustdoc link lints).
  doc: ""
